<?xml version="1.0" encoding="utf-8"?>
<!-- One finished push in the History list (v0.3.3). The row follows the
     git log essentials: subject, author, relative date, abbreviated SHA;
     GitHub Activity adds repo/branch and the "see the changes" affordance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground"
    tools:ignore="HardcodedText">

    <!-- Line 1: status + subject (commit message title). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/historyStatusIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/history_failed"
            tools:src="@drawable/ic_success" />

        <TextView
            android:id="@+id/historyTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Upload via ZipPush" />

        <TextView
            android:id="@+id/historyTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:maxLines="1"
            tools:text="2 h ago" />
    </LinearLayout>

    <!-- Line 2: repo · branch · folder. -->
    <TextView
        android:id="@+id/historyRepoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:maxLines="1"
        android:ellipsize="middle"
        tools:text="alice/repo · main · assignments/week3" />

    <!-- Line 3: author + files + size (+ short SHA / fail label). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/historyMetaText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="by alice · 3 files · 24 kB · a1b2c3d" />
    </LinearLayout>

    <!-- Expanded detail (tap): the files of this push and the GitHub
         link / failure reason. -->
    <TextView
        android:id="@+id/historyDetailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="26dp"
        android:paddingEnd="8dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone"
        android:textIsSelectable="true"
        tools:text="docs/report.txt" />
</LinearLayout>
